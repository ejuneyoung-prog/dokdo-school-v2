    {
      "id": 6,
      "ko": "사람과 시설",
      "en": "People and facilities",
      "category": "생활",
      "families": [
        "dk-lighthouse",
        "dk-dock",
        "dk-residence",
        "dk-freshwater",
        "dk-routes"
      ],
      "sourceIds": [
